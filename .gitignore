####################################################################################################################################
###                                                    Version Control Files                                                     ###
####################################################################################################################################

# Version control artifacts that are not from Git.

# Bazaar (bzr)/Breezy version control system
# https://github.com/breezy-team/breezy/
# https://github.com/github/gitignore/blob/main/Global/Bazaar.gitignore
.bzr/
**/.bzrignore

# CVS version control system
# https://www.nongnu.org/cvs/
# https://github.com/github/gitignore/blob/main/Global/CVS.gitignore
**/[Cc][Vv][Ss]/*
**/.cvsignore

# GNU DiffUtils tools
# https://www.gnu.org/software/diffutils/
# https://github.com/github/gitignore/blob/main/Global/Diff.gitignore
*.diff

# Mercurial (hg) version control system
# https://www.mercurial-scm.org/
# https://github.com/github/gitignore/blob/main/Global/Mercurial.gitignore
.hg/
.hgignore
.hgsigs
.hgsub
.hgsubstate
.hgtags

# GNU Patch utilities
# https://github.com/gitGNU/gnu_patch
# https://github.com/github/gitignore/blob/main/Global/Patch.gitignore
*.patch
*.rej

# Subversion (svn) version control system
# https://subversion.apache.org/
# https://github.com/github/gitignore/blob/main/Global/SVN.gitignore
.svn/

# TortoiseGit Windows shell interface for Git
# https://tortoisegit.org/
# https://github.com/github/gitignore/blob/main/Global/TortoiseGit.gitignore
/.tgitconfig

# Vagrant virtual machine management tool
# https://www.vagrantup.com/
# https://github.com/github/gitignore/blob/main/Global/Vagrant.gitignore
.vagrant/


