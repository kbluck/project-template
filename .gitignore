*.orig
*.original

# Norton Ghost backup files
*.gho


####################################################################################################################################
###                                                            macOS                                                             ###
####################################################################################################################################

# For macOS workstations to ignore temporary files, caches, system files, and cruft generated by common system apps.
# https://github.com/github/gitignore/blob/main/Global/macOS.gitignore

# Common macOS cruft
~$*
*~
._*
__MACOSX/
.[Dd][Ss]_[Ss]tore
.[Aa]pple[Dd]ouble
.[Ll][Ss][Oo]verride
[Ii]con*

# Files that might appear in the root of a volume
.[Dd]ocument[Rr]evisions*
.fseventsd
.[Ss]potlight*
.[Tt]emporary[Ii]tems
.[Tt]rashes
.[Vv]olume[Ii]con.icns
.com.apple.timemachine.donotpresent
.vol
.file
.disk_label*
lost+found

# Directories potentially created on remote AFP share
.[Aa]pple[Dd][Bb]
.[Aa]pple[Dd]esktop
[Nn]etwork [Tt]rash [Ff]older
[Tt]emporary [Ii]tems
.apdisk

# Quota system
.quota.*
.quota.ops.*

# TimeMachine
[Bb]ackups.backupdb
.[Mm]obile[Bb]ackups
.[Mm]obile[Bb]ackups.trash
[Mm]obile[Bb]ackups.trash
tmbootpicker.efi


####################################################################################################################################
###                                                            Linux                                                             ###
####################################################################################################################################

# For Linux workstations to ignore temporary files, caches, system files, and cruft generated by common system apps.
# https://github.com/github/gitignore/blob/main/Global/Linux.gitignore

# Temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# Trash folder which might appear on any partition or disk
.[Tt]rash-*

# .nfs files are created when an open file is removed but is still
# being accessed
.nfs*

# Log files created by default by the nohup command
nohup.*


####################################################################################################################################
###                                                           Windows                                                            ###
####################################################################################################################################

# For Windows workstations to ignore temporary files, caches, system files, and cruft generated by common system apps.
# https://github.com/github/gitignore/blob/main/Global/Windows.gitignore

# Thumbnail cache files
[Tt]humbs.db
[Tt]humbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Folder config file
[Dd]esktop.ini

# Shortcuts
*.lnk

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Dump files
*.stackdump

# Installer files
*.cab
*.msi
*.msix
*.msm
*.msp
